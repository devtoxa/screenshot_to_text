.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------
# 사용자 데이터 / 실행 중 생성되는 파일
# ---------------------------------------------------------------
# API 키가 들어갈 수 있는 개인 설정 (첫 실행 시 자동 생성)
config.json
.env
.env.*

# 캡처 원본/인식 결과
captures/

# 로그 (app.log, app.log.1, ...)
app.log*

# README 로 생성되는 HTML (PDF는 배포용으로 유지)
docs/*.html

# install.bat 이 내려받는 OCR 모델 (13MB 바이너리)
# 오프라인 배포를 위해 저장소에 포함하려면: git add -f models/korean/rec.onnx
models/korean/*.onnx
models/korean/dict.txt
models/korean/*.part

# ---------------------------------------------------------------
# 개발 중 임시 산출물
# ---------------------------------------------------------------
_probe*
_shot_*.png
_cmp_*.png
_korean*.png
_result_*.txt

